# Postgres (usa mesma URL do backend)
DATABASE_URL=postgres://fitandfails:postgres@db:5432/fitandfails

# Porta exposta pelo serviço de notificações
NOTIFICATION_PORT=4100

# Toggle para desabilitar push rapidamente
PUSH_ENABLED=true

# Credenciais do Firebase (FCM) - substitua pelos valores do service account
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=service-account@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSEU-KEY-AQUI\n-----END PRIVATE KEY-----\n"
